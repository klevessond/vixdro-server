# Copie para ".env" (que nunca vai para o git) e preencha.

# Chave do Django e dos tokens de login. Longa e aleatória (50+ caracteres):
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=app.orcaminio.com.br
CSRF_TRUSTED_ORIGINS=https://app.orcaminio.com.br
CORS_ALLOWED_ORIGINS=https://app.orcaminio.com.br

# Banco (PostgreSQL)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Pastas servidas pelo Nginx
STATIC_ROOT=
MEDIA_ROOT=

# Quantos proxies há na frente do Django. Com o Nginx: 1. Sem proxy nenhum: 0.
# Errado, o limite de tentativas de login pode ser burlado (ou barrar todo mundo junto).
NUM_PROXIES=1

# Cookies do admin só por HTTPS (padrão quando DEBUG=False).
# Servidor de teste sem HTTPS: COOKIES_SEGUROS=False
# COOKIES_SEGUROS=True

# Opcionais em produção (leia o comentário no settings.py antes de ligar):
# HSTS_SEGUNDOS=3600
# REDIRECIONAR_HTTPS=True

# Chave de cada fornecedor (o nome da variável é o cadastrado no admin):
# FORNECEDOR_SERIDO_CHAVE=
